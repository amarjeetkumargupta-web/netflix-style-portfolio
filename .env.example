# ============================================
# AVIKA MALIK PORTFOLIO — Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB Connection String
# Local: mongodb://localhost:27017/avika-portfolio
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/avika-portfolio
MONGODB_URI=mongodb://localhost:27017/avika-portfolio

# Gmail Credentials for sending email notifications
# IMPORTANT: Use a Gmail "App Password", NOT your regular password
# Steps to get App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to App Passwords → Generate one for "Mail"
#   4. Paste the 16-character password below
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# Owner email — where contact form notifications will be sent
# (defaults to EMAIL_USER if not set)
OWNER_EMAIL=your-email@gmail.com

# Server port (default: 3000)
PORT=3000
